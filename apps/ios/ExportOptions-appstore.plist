<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>2TWQF4T93E</string>
	<key>uploadSymbols</key>
	<true/>
	<!--
	  Manual, not automatic.

	  Automatic signing asks App Store Connect for a cloud-managed distribution
	  certificate, and that needs an API key with Admin rights. The certificate
	  here was issued against the CSR in ~/florin-signing instead, so the
	  profiles are named outright and the export needs no cloud call at all.
	-->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>iPhone Distribution: Adrien Robino (2TWQF4T93E)</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.adrbn.florin</key>
		<string>Florin App Store</string>
		<key>com.adrbn.florin.widgets</key>
		<string>Florin Widgets App Store</string>
	</dict>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
