<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 120 Hz, pas 60.

	     Sans cette clé, iOS plafonne l'app à 60 images par seconde sur un
	     écran ProMotion : les animations sautent une image sur deux et un
	     balayage d'onglet traîne. Elle ne fait qu'autoriser le système à
	     monter plus haut quand il le juge utile ; il redescend tout seul. -->
	<key>CADisableMinimumFrameDuration</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleDisplayName</key>
	<string>Florin</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Florin is self-hosted: the server is usually a box on the user's own
	     LAN or VPN, reachable over plain HTTP at a private address. This opts
	     into local-network HTTP only; public hosts still require TLS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Florin se connecte à ton propre serveur sur ce réseau. Aucune donnée ne sort de chez toi.</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AppLaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- The v2 layout is a portrait phone design; landscape would only stretch
	     a 390px-wide composition across the screen. -->
	<!-- Déverrouillé pour l'iPhone Duo : c'est `AppDelegate` qui tranche,
	     écran par écran — un téléphone ordinaire reste droit, un écran large
	     tourne avec l'appareil. Une liste réduite ici l'emporterait sur lui. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- Backups the user can actually find.

	     An export that only exists behind a share sheet is a file someone has
	     to route somewhere in the moment or lose. With these two keys the app's
	     Documents folder appears in Files under "Florin", so a copy sits
	     somewhere the person can open, mail, or hand to the restore picker on
	     the next phone without having thought ahead. Nothing sensitive lives
	     there: the ledger itself and the banking key stay in Application
	     Support, which this does not expose. -->
	<!-- Le scanner de tickets de caisse. Sans cette clé le système ne demande
	     rien et l'appareil photo ne s'ouvre pas : l'app plante à l'ouverture
	     du scanner. Les photos restent dans le conteneur de l'app. -->
	<key>NSCameraUsageDescription</key>
	<string>Florin ouvre l'appareil photo pour lire tes tickets de caisse. Les photos restent sur ton téléphone.</string>
	<!-- « Enregistrer dans Photos » depuis la visionneuse de ticket. Lire la
	     photothèque ne demande rien — le sélecteur système tourne hors de
	     l'app — mais y ajouter une image sans cette clé fait planter l'app au
	     moment de l'enregistrement. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Florin enregistre la photo d'un ticket dans tes Photos quand tu le demandes.</string>
	<!-- Shown by the system the first time Face ID is asked for. Without it
	     the prompt does not appear at all and the app looks broken. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Florin demande Face ID pour ouvrir votre grand livre.</string>
	<!-- Asked on every TestFlight and App Store upload, and it would be asked
	     again on each one if the answer were not stored here. Florin's only
	     cryptography is HTTPS and the RSA signature on its own API requests —
	     authentication, not content protection — which is the exemption every
	     such app claims. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.adrbn.florin.refresh</string>
	</array>
</dict>
</plist>
