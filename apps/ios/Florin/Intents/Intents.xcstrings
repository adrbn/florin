{
  "sourceLanguage": "en",
  "strings": {
    "intent.balances.description": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Respon amb el saldo de cadascun dels teus comptes, des del llibre d'aquest dispositiu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt den Saldo jedes Kontos aus dem Hauptbuch auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers with the balance of each of your accounts, from the ledger on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde con el saldo de cada una de tus cuentas, desde el libro de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répond avec le solde de chacun de vos comptes, depuis le grand livre de cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risponde con il saldo di ciascun conto, dal libro mastro su questo dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoordt met het saldo van elke rekening, uit het grootboek op dit apparaat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde com o saldo de cada conta, a partir do livro-razão deste dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki defterden her hesabınızın bakiyesini söyler."
          }
        }
      }
    },
