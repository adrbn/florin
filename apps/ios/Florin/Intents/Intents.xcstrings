    "intent.left.description": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Respon amb el que queda per gastar aquest mes, segons el llibre d'aquest dispositiu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt den Betrag, der diesen Monat noch zur Verfügung steht, aus dem Buch auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers with what is left to spend this month, from the ledger on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde con lo que queda por gastar este mes, según el libro de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répond ce qu'il vous reste à dépenser ce mois-ci, d'après le grand livre de cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risponde con quanto resta da spendere questo mese, dal registro su questo dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoordt met wat er deze maand nog te besteden is, uit het grootboek op dit apparaat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde com o que resta gastar este mês, a partir do livro neste dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay harcanacak ne kaldığını, bu cihazdaki deftere göre söyler."
          }
        }
      }
    },
