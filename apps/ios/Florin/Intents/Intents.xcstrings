    "intent.payment.description": {
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un pagament amb targeta com a previst a Florin. Quan el teu banc el comptabilitzi, la seva operació substitueix aquesta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst eine Kartenzahlung in Florin als anstehend. Sobald deine Bank sie bucht, ersetzt ihr Umsatz diesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records a card payment as upcoming in Florin. When your bank books it, the bank's transaction replaces this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un pago con tarjeta como previsto en Florin. Cuando tu banco lo contabiliza, su movimiento sustituye a este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un paiement par carte comme opération à venir dans Florin. Quand votre banque le comptabilise, son opération remplace celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un pagamento con carta come in arrivo in Florin. Quando la tua banca lo contabilizza, il suo movimento sostituisce questo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt een kaartbetaling in Florin vast als aankomend. Zodra je bank hem boekt, vervangt de transactie van de bank deze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista um pagamento com cartão como previsto no Florin. Quando o seu banco o contabilizar, o movimento do banco substitui este."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kart ödemesini Florin'de yaklaşan olarak kaydeder. Bankanız işlediğinde, bankanın işlemi bunun yerini alır."
          }
        }
      }
    },
