{
  "name": "@florin/desktop",
  "version": "1.3.4",
  "private": true,
  "main": "dist-main/index.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "dev": "node scripts/build-main.mjs && electron .",
    "build": "node ../../scripts/build-info.mjs desktop && node scripts/build-main.mjs && next build",
    "pack": "node ../../scripts/build-info.mjs desktop && node scripts/build-main.mjs && next build && electron-builder --mac --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "@florin/core": "workspace:*",
    "@florin/db-sqlite": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.45.0",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^39.8.10",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
