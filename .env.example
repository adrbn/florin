# Database
DB_PASSWORD=changeme

# Connection string used by the app (DO NOT change for compose)
DATABASE_URL=postgres://florin:changeme@localhost:5433/florin

# Auth
NEXTAUTH_SECRET=                # generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Single user credentials (set on first run)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=            # generate with: pnpm tsx scripts/hash-password.ts <password>

# App
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Live market prices for portfolio holdings (optional).
# 'yahoo' fetches quotes from Yahoo Finance for each holding's quote symbol
# (e.g. DCAM.PA); 'none' (default) keeps holdings at their manual value.
PRICE_PROVIDER=none
PRICE_API_KEY=                  # unused by 'yahoo'; reserved for keyed providers

# Display currency (ISO 4217). Default EUR.
APP_CURRENCY=EUR

# Tunable goal / investing defaults (France/EUR-first out of the box).
# Override for a different target, expected return, or tax-wrapper.
APP_GOAL_TARGET=100000          # long-term wealth target shown on the goal card
APP_GOAL_RETURN_PCT=7           # assumed net annual return %, used for the projection
APP_PEA_CEILING=150000          # tax-wrapper contribution cap (France PEA); 0 hides the gauge

# Enable Banking — register a free app at https://enablebanking.com/cp/applications
# Leave blank to disable bank linking (Florin will run in manual-only mode).
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=
ENABLE_BANKING_REDIRECT_URL=https://localhost:3000/api/banking/callback
